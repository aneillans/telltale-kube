<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TelltaleKube.App.ViewModels"
        xmlns:views="using:TelltaleKube.App.Views"
        x:Class="TelltaleKube.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/telltale-kube.ico"
        Title="Telltale Kube"
        Width="1280" Height="800" MinWidth="380" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <views:MainView />
</Window>
