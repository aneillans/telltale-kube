<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TelltaleKube.App.ViewModels"
             x:Class="TelltaleKube.App.Views.LogsView"
             x:DataType="vm:LogsViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="{DynamicResource KBorder}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="6">
        <WrapPanel>
          <WrapPanel.Styles>
            <Style Selector="WrapPanel > :is(Control)"><Setter Property="Margin" Value="0,0,8,6" /></Style>
          </WrapPanel.Styles>
          <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" MinWidth="200" IsVisible="{Binding HasMultipleSources}"
                    ToolTip.Tip="Which container's logs to show">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LogSource">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <Border Classes="badge" VerticalAlignment="Center"><TextBlock Text="{Binding Detail}" FontSize="11" /></Border>
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ToggleSwitch IsChecked="{Binding Previous}" IsEnabled="{Binding CanShowPrevious}" OnContent="Previous instance" OffContent="Previous instance"
                        ToolTip.Tip="Logs from before the container's last restart (kubectl logs --previous)" />
          <ToggleSwitch IsChecked="{Binding Follow}" IsEnabled="{Binding CanFollow}" OnContent="Follow" OffContent="Follow" />
          <CheckBox IsChecked="{Binding Timestamps}" Content="Timestamps" />
          <TextBox Text="{Binding Filter}" PlaceholderText="Filter" Width="200" />
          <Button Content="Restart" Command="{Binding RestartCommand}" />
          <Button Content="Stop" Command="{Binding StopCommand}" IsEnabled="{Binding IsStreaming}" />
          <Button Content="Copy" Command="{Binding CopyAllCommand}" />
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{Binding PreviousInfo}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Status}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Background="{DynamicResource KCode}">
      <ListBox x:Name="LinesList" ItemsSource="{Binding Lines}" Background="Transparent">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="0" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LogLine">
            <SelectableTextBlock Classes="mono" TextWrapping="Wrap">
              <Run Text="{Binding Prefix, Mode=OneWay, StringFormat='[{0}] '}" Foreground="{Binding PrefixBrush}" FontWeight="SemiBold" />
              <Run Text="{Binding Text, Mode=OneWay}" />
            </SelectableTextBlock>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</UserControl>
