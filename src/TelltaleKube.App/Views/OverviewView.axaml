<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TelltaleKube.App.ViewModels"
             xmlns:c="using:TelltaleKube.App.Converters"
             xmlns:ctl="using:TelltaleKube.App.Controls"
             x:Class="TelltaleKube.App.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="TopPodTemplate" x:DataType="vm:TopPodRow">
      <Button Classes="link" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6" Margin="0,0,0,2"
              Command="{Binding $parent[UserControl].((vm:OverviewViewModel)DataContext).OpenPodCommand}" CommandParameter="{Binding}"
              ToolTip.Tip="Show this pod">
        <StackPanel Spacing="2">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock TextTrimming="CharacterEllipsis">
              <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Namespace, Mode=OneWay}" Foreground="{DynamicResource KMuted}" />
            </TextBlock>
            <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" Margin="8,0,0,0" />
          </Grid>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="4" MinHeight="4" CornerRadius="2"
                       Foreground="{Binding Percent, Converter={x:Static c:PercentToBrushConverter.Instance}}" />
          <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11.5" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="16">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="h1" Text="Overview" />
        <Button Grid.Column="1" Command="{Binding LoadCommand}" Content="Refresh" />
      </Grid>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
      <Border Classes="error" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
      </Border>
      <ItemsControl ItemsSource="{Binding Tiles}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><ctl:CardPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StatTile">
            <Border Classes="card">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Width="8" Height="8" Fill="{Binding Health, Converter={x:Static c:HealthToBrushConverter.Instance}}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Label}" Classes="muted" />
                </StackPanel>
                <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Spacing="2">
        <TextBlock Classes="h2" Text="Resources" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap">
          <Run Text="{Binding UsageSourceText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding LastUpdated, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
      <ItemsControl ItemsSource="{Binding StatsNotes}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Border Classes="banner" Margin="0,0,0,6"><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" /></Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding Gauges}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><ctl:CardPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:UsageGauge">
            <Border Classes="card">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Label}" Classes="muted" />
                  <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontWeight="SemiBold"
                             Foreground="{Binding Percent, Converter={x:Static c:PercentToBrushConverter.Instance}}" />
                </Grid>
                <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding BarValue}" Height="6" MinHeight="6" CornerRadius="3"
                             Foreground="{Binding Percent, Converter={x:Static c:PercentToBrushConverter.Instance}}" />
                <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                <ctl:Sparkline Height="34" Margin="0,4,0,0" Values="{Binding History}" IsVisible="{Binding HasHistory}"
                               Stroke="{StaticResource KAccent}" ToolTip.Tip="Last 10 minutes (sampled every 15s)" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Classes="h2" Text="Nodes" IsVisible="{Binding NodeRows.Count}" />
      <ItemsControl ItemsSource="{Binding NodeRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NodeUsageRow">
            <Border Classes="card" Padding="12,10" Margin="0,0,0,8">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                           Fill="{Binding Health, Converter={x:Static c:HealthToBrushConverter.Instance}}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Flags}" IsVisible="{Binding HasFlags}" FontSize="12" Foreground="{StaticResource KDanger}" />
                </Grid>
                <Grid ColumnDefinitions="*,16,*">
                  <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="CPU  " Classes="muted" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding CpuText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding CpuBar}" Height="6" MinHeight="6" CornerRadius="3"
                                 Foreground="{Binding CpuBar, Converter={x:Static c:PercentToBrushConverter.Instance}}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="2">
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="Memory  " Classes="muted" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding MemText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding MemBar}" Height="6" MinHeight="6" CornerRadius="3"
                                 Foreground="{Binding MemBar, Converter={x:Static c:PercentToBrushConverter.Instance}}" />
                  </StackPanel>
                </Grid>
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding SummaryText}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <WrapPanel IsVisible="{Binding HasTopPods}">
        <StackPanel Width="400" Margin="0,0,16,12" Spacing="6">
          <TextBlock Classes="h2" Text="Top pods by CPU" />
          <ItemsControl ItemsSource="{Binding TopCpu}" ItemTemplate="{StaticResource TopPodTemplate}" />
        </StackPanel>
        <StackPanel Width="400" Margin="0,0,16,12" Spacing="6">
          <TextBlock Classes="h2" Text="Top pods by memory" />
          <ItemsControl ItemsSource="{Binding TopMemory}" ItemTemplate="{StaticResource TopPodTemplate}" />
        </StackPanel>
      </WrapPanel>

      <TextBlock Classes="h2" Text="Recent warnings" />
      <TextBlock Classes="muted" Text="No warning events." IsVisible="{Binding !Warnings.Count}" />
      <ItemsControl ItemsSource="{Binding Warnings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:EventRow">
            <Border Classes="card" Margin="0,0,0,8" Padding="12,10">
              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Reason, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource KWarning}" />
                    <Run Text="  " />
                    <Run Text="{Binding Target, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Grid.Column="1" Text="{Binding Age}" Classes="muted" />
                </Grid>
                <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="muted" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
